+package org.audiveris.omr.sheet.note;
+
+import java.awt.Rectangle;
+
+/** Default-off stemless-family guard; no source coordinates or target counts. */
+public final class StemlessGuard {
+    private StemlessGuard () {}
+
+    public static boolean stemConflict (Rectangle head, Rectangle seed, int margin, int interline) {
+        return seed.x <= head.x + head.width + margin && seed.x + seed.width >= head.x - margin
+            && seed.y <= head.y + head.height && seed.y + seed.height >= head.y
+            && (head.y - seed.y >= interline
+                || seed.y + seed.height - head.y - head.height >= interline);
+    }
+}
