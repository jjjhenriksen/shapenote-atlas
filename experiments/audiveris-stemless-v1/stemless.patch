     public void doit (Sheet sheet)
         throws StepException
     {
+        traceHeads(sheet, "ENTER");
         traceBars(sheet, "ENTER");
         helper.doit(sheet);
         traceBars(sheet, "EXIT");
+        traceHeads(sheet, "EXIT");
+    }
+
+    private void traceHeads (Sheet sheet, String phase)
+    {
+        if (!Boolean.getBoolean("atlas.stemlessTrace")) return;
+        if (!(this == HEADS || this == REDUCTION || this == CHORDS || this == RHYTHMS || this == PAGE)) return;
+        for (var system : sheet.getSystems()) {
+            int count = 0;
+            for (var inter : system.getSig().vertexSet()) {
+                if (inter instanceof org.audiveris.omr.sig.inter.HeadInter head) {
+                    var b = head.getBounds();
+                    var chord = head.getChord();
+                    System.out.println("STEMTRACE|" + name() + "|" + phase + "|" + system.getId()
+                        + "|" + head.getId() + "|" + head.getShape()
+                        + "|" + (head.getStaff() == null ? 0 : head.getStaff().getId())
+                        + "|" + b.x + "|" + b.y + "|" + b.width + "|" + b.height
+                        + "|" + head.getGrade() + "|" + (chord == null ? 0 : chord.getId())
+                        + "|" + (chord == null ? "null" : chord.getDuration())
+                        + "|" + (head.getVoice() == null ? 0 : head.getVoice().getId()));
+                    count++;
+                }
+            }
+            System.out.println("STEMCOUNT|" + name() + "|" + phase + "|" + system.getId() + "|" + count);
+        }
     }
 
