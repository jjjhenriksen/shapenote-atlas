     //------------------//
     // reduceExclusions //
     //------------------//
+    // Training-only, default-off experiment. Never freezes all bars or changes the column rule.
+    static Inter selectWeaker (Inter source, Inter target, boolean guard)
+    {
+        if (guard) {
+            if (source instanceof org.audiveris.omr.sig.inter.BarlineInter && isFaOnlyStem(target)) return target;
+            if (target instanceof org.audiveris.omr.sig.inter.BarlineInter && isFaOnlyStem(source)) return source;
+        }
+        return source.getBestGrade() < target.getBestGrade() ? source : target;
+    }
+
+    private static boolean isFaOnlyStem (Inter inter)
+    {
+        if (!(inter instanceof org.audiveris.omr.sig.inter.StemInter)) return false;
+        var heads = ((org.audiveris.omr.sig.inter.StemInter) inter).getHeads();
+        return !heads.isEmpty() && heads.stream().allMatch(
+            head -> org.audiveris.omr.glyph.ShapeSet.HeadsFa.contains(head.getShape()));
+    }
+
