diff --git a/app/src/main/java/org/audiveris/omr/step/OmrStep.java b/app/src/main/java/org/audiveris/omr/step/OmrStep.java
index 91e0a27..f0696c7 100644
--- a/app/src/main/java/org/audiveris/omr/step/OmrStep.java
+++ b/app/src/main/java/org/audiveris/omr/step/OmrStep.java
@@ -135,7 +135,28 @@ public enum OmrStep
     public void doit (Sheet sheet)
         throws StepException
     {
+        traceBars(sheet, "ENTER");
         helper.doit(sheet);
+        traceBars(sheet, "EXIT");
+    }
+
+    private void traceBars (Sheet sheet, String phase)
+    {
+        if (!Boolean.getBoolean("atlas.barTrace")) return;
+        for (var system : sheet.getSystems()) {
+            int count = 0;
+            for (var inter : system.getSig().vertexSet()) {
+                if (inter instanceof org.audiveris.omr.sig.inter.BarlineInter) {
+                    var b = inter.getBounds();
+                    System.out.println("BARTRACE|" + name() + "|" + phase + "|" + system.getId()
+                        + "|" + inter.getId() + "|" + (inter.getStaff() == null ? 0 : inter.getStaff().getId())
+                        + "|" + (inter.getGlyph() == null ? 0 : inter.getGlyph().getId())
+                        + "|" + b.x + "|" + b.y + "|" + b.width + "|" + b.height + "|" + inter.getGrade());
+                    count++;
+                }
+            }
+            System.out.println("BARCOUNT|" + name() + "|" + phase + "|" + system.getId() + "|" + count);
+        }
     }
 
