+    // Experimental opt-in policy: only direct logical fa-head / physical-bar conflicts.
+    // Other bar conflicts, non-fa heads, and the default-off path retain upstream ordering.
+    static Inter selectWeaker (Inter source, Inter target, boolean guard)
+    {
+        if (guard) {
+            if (source instanceof org.audiveris.omr.sig.inter.BarlineInter && isFaHead(target)) return target;
+            if (target instanceof org.audiveris.omr.sig.inter.BarlineInter && isFaHead(source)) return source;
+        }
+        return source.getBestGrade() < target.getBestGrade() ? source : target;
+    }
+
+    private static boolean isFaHead (Inter inter)
+    {
+        return inter instanceof org.audiveris.omr.sig.inter.HeadInter && inter.getShape() != null
+            && org.audiveris.omr.glyph.ShapeSet.HeadsFa.contains(inter.getShape());
+    }
+
