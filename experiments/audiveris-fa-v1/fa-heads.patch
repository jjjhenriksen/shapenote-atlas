diff --git a/app/src/test/java/org/audiveris/omr/image/FaHeadPrototypeTest.java b/app/src/test/java/org/audiveris/omr/image/FaHeadPrototypeTest.java
new file mode 100644
index 0000000..6c54232
--- /dev/null
+++ b/app/src/test/java/org/audiveris/omr/image/FaHeadPrototypeTest.java
@@ -0,0 +1,64 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+package org.audiveris.omr.image;
+
+import org.audiveris.omr.glyph.Shape;
+import org.audiveris.omr.glyph.ShapeSet;
+import org.audiveris.omr.math.Rational;
+import org.audiveris.omr.sheet.ProcessingSwitch;
+import org.audiveris.omr.ui.symbol.MusicFamily;
+import org.audiveris.omr.ui.symbol.MusicFont;
+import org.junit.BeforeClass;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class FaHeadPrototypeTest
+{
+    @BeforeClass
+    public static void initializeFontSymbols ()
+    {
+        MusicFont.populateAllSymbols();
+    }
+
+    @Test
+    public void pitchedLogicalHeadsDoNotChangePhysicalClassifierVocabulary ()
+    {
+        for (Shape shape : ShapeSet.HeadsFa) {
+            assertTrue(shape.isHead());
+            assertFalse(shape.isTrainable());
+            assertFalse(shape.isPercussion());
+            assertTrue(shape.ordinal() > Shape.LAST_PHYSICAL_SHAPE.ordinal());
+            assertEquals(ShapeSet.HeadMotif.fa, shape.getHeadMotif());
+        }
+        assertFalse(ProcessingSwitch.faHeads.getConstant().getValue());
+    }
+
+    @Test
+    public void intrinsicDurationDistinguishesFillWithoutUsingPitch ()
+    {
+        assertEquals(Rational.QUARTER, Shape.NOTEHEAD_FA_LEFT_FILLED.getNoteDuration());
+        assertEquals(Rational.QUARTER, Shape.NOTEHEAD_FA_UP_RIGHT_FILLED.getNoteDuration());
+        assertEquals(Rational.HALF, Shape.NOTEHEAD_FA_LEFT_VOID.getNoteDuration());
+        assertEquals(Rational.HALF, Shape.NOTEHEAD_FA_UP_RIGHT_VOID.getNoteDuration());
+    }
+
+    @Test
+    public void bothOpenOrientationsHaveRealInteriorHolePixels ()
+    {
+        for (Shape shape : new Shape[] {Shape.NOTEHEAD_FA_LEFT_VOID, Shape.NOTEHEAD_FA_UP_RIGHT_VOID}) {
+            Template template = TemplateFactory.getInstance().getCatalog(MusicFamily.Bravura, 60).getTemplate(shape);
+            assertNotNull(template);
+            assertTrue(template.getKeyPoints().stream().anyMatch(p -> p.d < 0));
+            assertTrue(template.getKeyPoints().stream().anyMatch(p -> p.d == 0));
+        }
+    }
+
+    @Test
+    public void filledOrientationsHaveNoHoleMask ()
+    {
+        for (Shape shape : new Shape[] {Shape.NOTEHEAD_FA_LEFT_FILLED, Shape.NOTEHEAD_FA_UP_RIGHT_FILLED}) {
+            Template template = TemplateFactory.getInstance().getCatalog(MusicFamily.Bravura, 60).getTemplate(shape);
+            assertNotNull(template);
+            assertFalse(template.getKeyPoints().stream().anyMatch(p -> p.d < 0));
+        }
+    }
+}
