+    // Native-family partner, default off for logical fa; ordinary behavior unchanged.
+    static Shape holePartner (Shape shape, boolean enabled)
+    {
+        if (shape == Shape.NOTEHEAD_BLACK) return Shape.NOTEHEAD_VOID;
+        if (!enabled) return null;
+        return switch (shape) {
+            case NOTEHEAD_FA_LEFT_FILLED -> Shape.NOTEHEAD_FA_LEFT_VOID;
+            case NOTEHEAD_FA_UP_RIGHT_FILLED -> Shape.NOTEHEAD_FA_UP_RIGHT_VOID;
+            default -> null;
+        };
+    }
